# DrugRef2026 image for the carlos-app pod: builds drugref2.war from source —
# or, in WAR mode (DRUGREF_WAR_STAGE=download, see below), downloads a
# published release WAR — and packages it on Tomcat 11, mirroring the drugref
# service in the carlos-emr/carlos devcontainer (.devcontainer/drugref/Dockerfile).
#
#   podman build --no-cache -t localhost/carlos-drugref:latest -f Containerfile.drugref .
#   (--no-cache matters: `ADD <url>` caches on the URL string, so a plain
#   rebuild of the SAME moving ref can silently ship a stale cached tarball;
#   carlos-ctl build passes --no-cache by default)
#   podman build --build-arg DRUGREF_REF=<branch-or-tag-or-SHA> ...
#
# REPRODUCIBILITY: `master` is a moving branch. For releases pin a COMMIT SHA
# (archive/<sha>.tar.gz works with --strip-components=1). `ADD <url>` caches on
# the URL string, so a rebuild of the same branch ref can reuse a stale tarball
# — `carlos-ctl build`/`rebuild` pass --no-cache by default (and warn on
# non-SHA refs). Base images are pinned tag@digest (re-resolve with skopeo
# when bumping the tag; digests resolved 2026-07).
ARG DRUGREF_REF=master
# WAR-artifact mode — same mechanism as the CARLOS Containerfile: when a
# GitHub release publishes a prebuilt WAR (drugref2.war on current releases),
# `carlos-ctl build` selects the `download` stage below instead of the Maven
# compile by passing DRUGREF_WAR_STAGE=download plus the asset URL and its
# MANDATORY sha256. The defaults keep the historical compile-from-source
# behavior; unused stages are skipped by both engines (see the CARLOS
# Containerfile's note).
ARG DRUGREF_WAR_URL=""
ARG DRUGREF_WAR_SHA256=""
ARG DRUGREF_WAR_STAGE=build
# Reproducibility helpers (cosmetic). Pass --build-arg SOURCE_DATE_EPOCH=<ts>
# for a reproducible release build. Declared per stage — an ENV before the
# first FROM is a spec violation, and a global ARG is invisible inside stages
# unless redeclared (see the CARLOS Containerfile).
ARG SOURCE_DATE_EPOCH=""

FROM docker.io/library/maven:3.9-eclipse-temurin-21@sha256:2b4496088e7b80ae10a8c9f74e574ea21380325a006ec684532ad6bad5bc7273 AS build
ARG DRUGREF_REF
ARG SOURCE_DATE_EPOCH=""
ENV TZ=UTC \
    SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH}
# Optional source-tarball integrity (audited release builds) — see the CARLOS
# Containerfile / README supply-chain note. Empty default skips the check.
ARG DRUGREF_SRC_SHA256=""
# EXTRA CA (build stage only) — same hook as the CARLOS Containerfile: a
# committed 0-byte placeholder is inert by default; `carlos-ctl build` stages
# the proxy CA bundle here for a TLS-inspecting egress proxy. Build stage only,
# does not weaken the digest-pinned base images. See the README supply-chain note.
COPY .extra-ca-bundle.crt /usr/local/share/ca-certificates/carlos-extra-ca.crt
# Skip cert-free pieces (bundle preamble), fail the build on a real import
# error — see the CARLOS Containerfile's note on the swallowed-loop hazard.
RUN if [ -s /usr/local/share/ca-certificates/carlos-extra-ca.crt ]; then \
        update-ca-certificates \
        && csplit -z -f /tmp/ca- -b '%02d.crt' \
             /usr/local/share/ca-certificates/carlos-extra-ca.crt \
             '/BEGIN CERTIFICATE/' '{*}' \
        && for c in /tmp/ca-*.crt; do \
             grep -q 'BEGIN CERTIFICATE' "$c" || continue; \
             keytool -importcert -cacerts -storepass changeit -noprompt \
               -alias "carlos-extra-$(basename "$c" .crt)" -file "$c" || exit 1; \
           done \
        && rm -f /tmp/ca-*.crt; \
    else rm -f /usr/local/share/ca-certificates/carlos-extra-ca.crt; fi
ADD https://github.com/carlos-emr/drugref2026/archive/${DRUGREF_REF}.tar.gz /tmp/drugref-src.tar.gz
RUN if [ -n "$DRUGREF_SRC_SHA256" ]; then echo "$DRUGREF_SRC_SHA256  /tmp/drugref-src.tar.gz" | sha256sum -c -; fi \
    && mkdir /src && tar -xzf /tmp/drugref-src.tar.gz -C /src --strip-components=1
WORKDIR /src
RUN --mount=type=cache,target=/root/.m2 \
    mvn -B -DskipTests=true package \
    && cp target/drugref2.war /drugref2.war

# WAR download stage — the published release asset instead of the compile.
# Based on the SAME digest-pinned tomcat image as the runtime stage; the
# `ADD <url>` is fetched by the BUILDER process on the host (host trust
# store), so no extra-CA import is needed here. The sha256 check is
# MANDATORY: a URL-fetched WAR is only trustworthy content-addressed.
FROM docker.io/library/tomcat:11.0-jre21-temurin@sha256:c595b874e38743ad1204bce977fb12b07a3c6b3dd118bc9c1fa2616b7a78d544 AS download
ARG DRUGREF_WAR_URL
ARG DRUGREF_WAR_SHA256
ADD ${DRUGREF_WAR_URL} /drugref2.war
RUN test -n "$DRUGREF_WAR_SHA256" \
    && echo "$DRUGREF_WAR_SHA256  /drugref2.war" | sha256sum -c -

# Alias the selected WAR source so the runtime stage below mounts ONE fixed
# stage name whichever path produced /drugref2.war.
FROM ${DRUGREF_WAR_STAGE} AS warsrc

# DrugRef needs no JDK tools at runtime (unlike carlos, whose README JFR/jcmd
# diagnostics require the JDK), so it runs on the smaller JRE image.
FROM docker.io/library/tomcat:11.0-jre21-temurin@sha256:c595b874e38743ad1204bce977fb12b07a3c6b3dd118bc9c1fa2616b7a78d544
ENV TZ=UTC
# Serve only /drugref2, guarded loopback-only by an EXTERNAL context
# descriptor (below) — exactly right inside the pod's shared network
# namespace, where CARLOS reaches DrugRef over 127.0.0.1:8180.
RUN rm -rf /usr/local/tomcat/webapps/*
# Pre-explode the WAR at BUILD time, root-owned: the pod runs this container
# with readOnlyRootFilesystem (Tomcat never writes webapps/ at startup), and
# the served tree is not writable by the runtime uid (no JSP drops).
# unzip (not `jar`): the JRE runtime image ships no jar tool.
# apt packages are intentionally NOT version-pinned — see the CARLOS
# Containerfile / README supply-chain note (digest-pinned base = pinned lineage).
# Bind-mounted from the selected source stage (warsrc = compile or download,
# see DRUGREF_WAR_STAGE above) rather than COPY'd: a COPY layer would
# permanently carry the full WAR bytes next to the exploded tree (see the
# CARLOS Containerfile note); the mount leaves no layer behind.
RUN --mount=type=bind,from=warsrc,source=/drugref2.war,target=/tmp/drugref2.war \
    apt-get update \
    && apt-get install -y --no-install-recommends unzip \
    && mkdir /usr/local/tomcat/webapps/drugref2 \
    && cd /usr/local/tomcat/webapps/drugref2 \
    && unzip -q /tmp/drugref2.war \
    && apt-get purge -y unzip && rm -rf /var/lib/apt/lists/*
# Override the WAR's META-INF/context.xml with an external descriptor: the
# in-WAR valve's ${...:127.0.0.1/32,::1/128} placeholder DEFAULT is
# un-parseable (RemoteCIDRValve splits `allow` on commas before property
# substitution — the upstream devcontainer overrides it for the same reason),
# so a hardcoded loopback-only allow list is baked in instead. Tomcat prefers
# conf/Catalina/localhost/drugref2.xml and ignores the in-WAR file entirely.
COPY conf/drugref/drugref2-context.xml /usr/local/tomcat/conf/Catalina/localhost/drugref2.xml
# Pod-ready server.xml: HTTP connector on 8180, shutdown port disabled, so
# this Tomcat coexists with the CARLOS Tomcat (8080/8005) in one network
# namespace. The pod spec also bind-mounts the same file from
# $EMR_HOME/container/conf/drugref so it can be edited without a rebuild.
COPY conf/drugref/server.xml /usr/local/tomcat/conf/server.xml
# DrugRef resolves its config as ${user.home}/drugref2.properties — i.e. from
# the HOME of whatever user the JVM runs as. The runtime user's home is
# /home/drugref, and we bake a symlink there pointing at the tmpfs emptyDir the
# `drugref-init` initContainer assembles config into — so DrugRef finds it with
# no /root involvement and no runtime symlink creation.
#
# Fully non-root (uid 10001). The initContainer does the root-only config
# assembly; this image just needs the user, tini, and the baked symlink.
# USER 10001 (numeric) so runAsNonRoot admission passes. work/ and temp/ are
# deliberately NOT chowned — the pod runs this image with
# readOnlyRootFilesystem and mounts emptyDirs there (chowned by drugref-init);
# webapps/ stays root-owned read-only (pre-exploded above).
RUN groupadd -g 10001 drugref \
    && useradd -u 10001 -g 10001 -d /home/drugref -m -s /usr/sbin/nologin drugref \
    && apt-get update \
    # mariadb-client-core provides the `mariadb` client for the pod's
    # wait-for-db loop ONLY (same reason the CARLOS image ships it): DrugRef
    # builds its Hibernate SessionFactory at context start and never retries,
    # so the pod command polls for the `drugref2` database before starting
    # Tomcat. Ubuntu's `default-mysql-client` resolves to the Oracle client
    # (no `mariadb` binary), so pin the real MariaDB one. The container still
    # runs non-root / read-only-root / drop-ALL.
    && apt-get install -y --no-install-recommends tini mariadb-client-core \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s /run/drugref-config/drugref2.properties /home/drugref/drugref2.properties
USER 10001
# The two hibernate.* flags are DEPLOY-CRITICAL against MariaDB (the DB this
# deployment pins), not tuning: DrugRef's spring_config.xml names no dialect,
# so Hibernate 6 auto-detects one from JDBC metadata, and the bundled
# mysql-connector-j 9.1 implements getSQLKeywords() as
#   SELECT WORD FROM INFORMATION_SCHEMA.KEYWORDS WHERE RESERVED=1
# — a column MariaDB's information_schema.KEYWORDS does not have (ERROR 1054).
# Metadata access then fails, the entityManagerFactory bean fails to build, the
# /drugref2 context never starts, and Tomcat serves 404 forever. The pod spec
# sets the same two flags (it overrides CATALINA_OPTS wholesale); these are the
# standalone-`podman run` copy, and the reason the HEALTHCHECK below can accept
# any status without hiding a dead context. Verified live: GET /drugref2/ is
# 404 without them, 200 with them.
ENV CATALINA_OPTS="-Djava.awt.headless=true -Dhibernate.dialect=org.hibernate.dialect.MariaDBDialect -Dhibernate.boot.allow_jdbc_metadata_access=false"
EXPOSE 8180
# Standalone-run liveness (the pod livenessProbe takes precedence under kube
# play). bash /dev/tcp — no curl/wget in the image. An HTTP-response probe,
# not a bare port-open: a hung Tomcat keeps the socket accepting while never
# answering. Any status counts as alive (DrugRef exposes web services, not a
# guaranteed index page, so a 404 here is not a deploy failure signal).
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=5 \
    CMD bash -c 'exec 3<>/dev/tcp/127.0.0.1/8180 \
        && printf "GET /drugref2/ HTTP/1.0\r\nHost: localhost\r\n\r\n" >&3 \
        && head -1 <&3 | grep -qE "^HTTP/1\.[01] [0-9]{3}"' || exit 1
# tini as PID 1 for standalone runs too (the pod spec passes it explicitly in
# its command override): child reaping + SIGTERM forwarding.
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["catalina.sh", "run"]
