# {{ ansible_managed | default('Managed by the carlos_podman Ansible role') }}
# Site configuration for instance '{{ carlos_instance }}' — the runtime
# contract carlos-ctl (and its systemd units) read on every invocation.
#
# DO NOT EDIT DIRECTLY: this file is playbook-owned. Change the value in
# host_vars/{{ carlos_instance }}.yml, re-run ansible-playbook (which also
# re-renders the pod specs and units that consume it), then `carlos-ctl play`.
EMR_HOME={{ carlos_emr_home }}
INSTANCE={{ carlos_instance }}
SERVICE_USER={{ carlos_service_user }}
BIND_IP={{ carlos_bind_ip }}
SERVER_NAME={{ carlos_server_name }}
HTTPS_PORT={{ carlos_https_port }}
HTTPS_PUBLISH_PORT={{ carlos_https_publish_port }}
LOG_VIEW_PORT={{ carlos_log_view_port }}
VICTORIALOGS_PORT={{ carlos_victorialogs_port }}
VICTORIAMETRICS_PORT={{ carlos_victoriametrics_port }}
VMALERT_PORT={{ carlos_vmalert_port }}
PMA_PORT={{ carlos_pma_port }}
TZ={{ carlos_tz }}
LOG_VERBOSITY={{ carlos_log_verbosity }}
DB_AUTO_UPGRADE={{ carlos_db_auto_upgrade }}
# Observability profile: rendered from carlos_obs_enabled; the monitor picks
# its mode (vmalert relay vs direct liveness sweep) from this.
OBS_ENABLED={{ '1' if carlos_obs_enabled | bool else '0' }}
# Host firewall expectation: rendered from carlos_host_firewall_enabled so the
# guard and monitor can verify the inet {{ carlos_instance }}-hostfw
# default-deny table is actually LOADED (the nft apply unit is fail-open).
HOSTFW_ENABLED={{ '1' if carlos_host_firewall_enabled | default(false) | bool else '0' }}
# Front-door TLS mode: selfsigned (auto-generated) | manual | acme (certbot).
CARLOS_TLS_MODE={{ carlos_tls_mode }}
{% if carlos_tls_mode == 'acme' %}
ACME_EMAIL={{ carlos_acme_email }}
CERTBOT_IMAGE={{ carlos_certbot_image }}
HTTP_PUBLISH_PORT={{ carlos_http_publish_port }}
{% endif %}
{% if carlos_obs_enabled | bool and carlos_obs_http_auth | bool %}
# Store basic-auth USERNAME only — the password lives root-only in
# $EMR_HOME/secrets-private/obs-http-password (carlos-ctl reads it there).
OBS_HTTP_USER={{ carlos_obs_http_user }}
{% endif %}
CARLOS_IMAGE={{ carlos_image }}
DRUGREF_IMAGE={{ carlos_drugref_image }}
DB_IMAGE={{ carlos_db_image }}
WAF_IMAGE={{ carlos_waf_image }}
RESTIC_IMAGE={{ carlos_restic_image }}
PHPMYADMIN_IMAGE={{ carlos_phpmyadmin_image }}
{% if carlos_obs_enabled | bool %}
VICTORIALOGS_IMAGE={{ carlos_victorialogs_image }}
VICTORIAMETRICS_IMAGE={{ carlos_victoriametrics_image }}
VMAGENT_IMAGE={{ carlos_vmagent_image }}
VMALERT_IMAGE={{ carlos_vmalert_image }}
NODE_EXPORTER_IMAGE={{ carlos_node_exporter_image }}
MYSQLD_EXPORTER_IMAGE={{ carlos_mysqld_exporter_image }}
VECTOR_IMAGE={{ carlos_vector_image }}
CADDY_IMAGE={{ carlos_caddy_image }}
LOG_RETENTION={{ carlos_log_retention }}
METRICS_RETENTION={{ carlos_metrics_retention }}
LOG_VIEW_USER={{ carlos_log_view_user }}
LOG_VIEW_ALLOW_CIDR={{ carlos_log_view_allow_cidr }}
{% endif %}
CARLOS_MEM_LIMIT={{ carlos_mem_limit }}
CARLOS_JAVA_XMS={{ carlos_java_xms }}
CARLOS_JAVA_XMX={{ carlos_java_xmx }}
DRUGREF_MEM_LIMIT={{ carlos_drugref_mem_limit }}
DRUGREF_JAVA_XMX={{ carlos_drugref_java_xmx }}
DB_MEM_LIMIT={{ carlos_db_mem_limit }}
WAF_PARANOIA={{ carlos_waf_paranoia }}
WAF_ANOMALY_INBOUND={{ carlos_waf_anomaly_inbound }}
WAF_ANOMALY_OUTBOUND={{ carlos_waf_anomaly_outbound }}
WAF_SSL_PROTOCOLS={{ carlos_waf_ssl_protocols }}
WAF_SSL_CIPHERS={{ carlos_waf_ssl_ciphers }}
WAF_AUDIT_LOG_PARTS={{ carlos_waf_audit_log_parts }}
CERT_EXPIRY_WARN_DAYS={{ carlos_cert_expiry_warn_days }}
{# One knob, two consumers: the monitor's local statvfs sweep reads this
   line while vmalert's DiskLow rule is templated from the same
   carlos_disk_min_free — rendering it here keeps the thresholds from
   splitting. #}
DISK_MIN_FREE={{ carlos_disk_min_free }}
CARLOS_REF={{ carlos_ref }}
CARLOS_ARTIFACT={{ carlos_artifact }}
CARLOS_SOURCE_BRANCH={{ carlos_source_branch }}
DRUGREF_REF={{ carlos_drugref_ref }}
DRUGREF_ARTIFACT={{ carlos_drugref_artifact }}
DRUGREF_SOURCE_BRANCH={{ carlos_drugref_source_branch }}
CARLOS_IMAGE_REPO={{ carlos_image_repo }}
DRUGREF_IMAGE_REPO={{ carlos_drugref_image_repo }}
{% if carlos_pod_dns %}
POD_DNS={{ carlos_pod_dns }}
{% endif %}
# The three alert-channel keys are also MIRRORED root-only to
# {{ carlos_instance_registry_dir | default('/etc/carlos-podman/instances') }}/{{ carlos_instance }}.alert.env
# so guard/alert pages stay deliverable when this file's volume is unmounted —
# carlos-ctl falls back to the mirror only for keys that resolve EMPTY here.
{% if carlos_alert_webhook %}
ALERT_WEBHOOK={{ carlos_alert_webhook }}
{% endif %}
{% if carlos_alert_email %}
ALERT_EMAIL={{ carlos_alert_email }}
{% endif %}
{% if carlos_heartbeat_url %}
HEARTBEAT_URL={{ carlos_heartbeat_url }}
{% endif %}
{% if carlos_extra_env %}
# Site extras from host_vars carlos_extra_env — the durable home for the
# operational knobs carlos-ctl reads that have no dedicated carlos_* var
# (ALERT_REMIND_HOURS, BACKUP_MAX_AGE_HOURS, CARLOS_ACCEPT_LOCAL_REPO, ...).
{% for k, v in carlos_extra_env.items() %}
{{ k }}={{ v }}
{% endfor %}
{% endif %}
{# The root password: plain when shell-safe, else the $'...' ANSI-C form the
   CLI's parse-don't-source reader (and a sourcing shell) both decode. #}
{% if carlos_db_root_password is match('^[A-Za-z0-9@%_+=:,./-]+$') %}
CARLOS_DB_ROOT_PASSWORD={{ carlos_db_root_password }}
{% else %}
CARLOS_DB_ROOT_PASSWORD=$'{{ carlos_db_root_password | replace('\\', '\\\\') | replace("'", "\\'") }}'
{% endif %}
