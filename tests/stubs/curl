# Test stub for curl — the monitor and `check` probe the loopback-published
# VictoriaMetrics/VictoriaLogs endpoints with curl; real curl would fail every
# probe in the hermetic env (nothing listens), so this stub answers the store
# endpoints deterministically and refuses everything else (front-door HTTPS,
# webhooks) so those paths keep exercising their failure branches.
#   STUB_VM_DOWN=1     VictoriaMetrics (:8428) /health becomes unreachable
#   STUB_VL_DOWN=1     VictoriaLogs (:9428) /health becomes unreachable
#   STUB_LOGS_STALE=1  VictoriaLogs /health OK but the recency query is EMPTY
#                      (running-but-not-shipping pipeline)
#   STUB_MYSQL_DOWN=1  the mysql_up scalar reads 0 (db-down corroboration)
#   STUB_WEBHOOK_OK=1  webhook POSTs (any non-store URL with -X POST) succeed
#   STUB_FRONT_DOOR=<code>  the front-door HTTPS probe (-w %{http_code})
#                      answers <code>; unset = connection refused (exit 7),
#                      the fail-closed default
#   STUB_STORE_AUTH=1  the stores ENFORCE basic auth: a store URL whose -K
#                      config carries no `user =` line is rejected (exit 22)
#                      — drives check's auth-enforcement probe both ways
#   STUB_GH_DOWN=1     api.github.com becomes unreachable (exit 7) — drives
#                      carlos_ctl.source's offline branches (pinned builds
#                      must not care; unpinned resolution must refuse)
#   STUB_GH_RELEASES=full|prerelease-only|none  what the carlos release list
#                      answers (default full: one non-prerelease with a WAR
#                      asset + sha256 digest — the release-first happy path)
#   STUB_GH_DR_RELEASES=full|none  what the drugref2026 release list answers
#                      (default full: one non-prerelease with the fixed-name
#                      drugref2.war asset + digest, modelling live v1.0.0rc2)
#   STUB_GHCR_DOWN=1   ghcr.io becomes unreachable (exit 7) — image-artifact
#                      digest resolution must refuse with guidance
#   STUB_GHCR_MISSING=1  the manifest HEAD 404s (exit 22) — release published
#                      but no image pushed for it yet
echo "curl $*" >> "${STUBLOG:-/dev/null}"

# When the caller passes the URL off-argv via `-K -` (config on stdin), real
# curl reads stdin; drain it here so the upstream `printf | curl` producer does
# not take SIGPIPE (which pipefail would surface as a delivery failure). Record
# the config so tests can still see the URL that was sent.
url=""
cfg=""
for a in "$@"; do
    case "$a" in
        http://*|https://*) url="$a";;
        -K) cfg="$(cat 2>/dev/null || true)"; echo "curl-config $cfg" >> "${STUBLOG:-/dev/null}"
            url="$(printf '%s' "$cfg" | sed -n 's/.*url *= *"\([^"]*\)".*/\1/p' | head -n1)";;
    esac
done

# Store-auth enforcement mode: like the real -httpAuth.* stores, reject any
# store request whose config carries no credential.
if [[ -n "${STUB_STORE_AUTH:-}" ]]; then
    case "$url" in
        *:8428/*|*:9428/*|*:8880/*)
            if [[ "$cfg" != *'user = "'* ]]; then exit 22; fi;;
    esac
fi

# GitHub API (carlos_ctl.source): deterministic release/commit answers so the
# release-first resolution is testable end to end — for BOTH app repos. The
# commit and WAR sha256 values are fixed test constants the suite's
# assertions grep for (carlos commit 1111…, drugref commit 3333…).
# ghcr.io (carlos_ctl.source resolve_image_digest): anonymous token + manifest
# HEAD. The digest constant is what the image-artifact assertions grep for.
GHCR_DIGEST="sha256:eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee"
if [[ "$url" == https://ghcr.io/token* ]]; then
    [[ -n "${STUB_GHCR_DOWN:-}" ]] && exit 7
    echo '{"token":"stub-registry-token"}'
    exit 0
fi
if [[ "$url" == https://ghcr.io/v2/*/manifests/* ]]; then
    [[ -n "${STUB_GHCR_DOWN:-}" ]] && exit 7
    [[ -n "${STUB_GHCR_MISSING:-}" ]] && exit 22
    # Model the real ghcr: the unauthenticated HEAD answers a 401 Bearer
    # challenge naming the token realm; the authorized retry gets the digest.
    if [[ " $* " == *"Authorization: Bearer "* ]]; then
        printf 'HTTP/2 200\ndocker-content-digest: %s\ncontent-length: 3\n' "$GHCR_DIGEST"
    else
        repo_path="${url#https://ghcr.io/v2/}"; repo_path="${repo_path%%/manifests/*}"
        printf 'HTTP/2 401\nwww-authenticate: Bearer realm="https://ghcr.io/token",service="ghcr.io",scope="repository:%s:pull"\n' "$repo_path"
    fi
    exit 0
fi

GH_SHA="1111111111111111111111111111111111111111"
GH_WAR_SHA="dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd"
GH_DR_SHA="3333333333333333333333333333333333333333"
GH_DR_WAR_SHA="ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"
if [[ "$url" == https://api.github.com/repos/carlos-emr/carlos/* ]]; then
    [[ -n "${STUB_GH_DOWN:-}" ]] && exit 7
    case "$url" in
        */releases?*)
            case "${STUB_GH_RELEASES:-full}" in
                none) echo '[]';;
                prerelease-only)
                    printf '[{"tag_name":"2026.08.0-alpha1","prerelease":true,"draft":false,"published_at":"2026-08-18T19:22:53Z","assets":[{"name":"carlos-2026.08.0-alpha1.war","browser_download_url":"https://github.com/carlos-emr/carlos/releases/download/2026.08.0-alpha1/carlos-2026.08.0-alpha1.war","digest":"sha256:%s"}]}]\n' "$GH_WAR_SHA";;
                *)
                    printf '[{"tag_name":"2026.08.0","prerelease":false,"draft":false,"published_at":"2026-08-18T19:22:53Z","assets":[{"name":"carlos-2026.08.0.war","browser_download_url":"https://github.com/carlos-emr/carlos/releases/download/2026.08.0/carlos-2026.08.0.war","digest":"sha256:%s"}]}]\n' "$GH_WAR_SHA";;
            esac
            exit 0;;
        */commits/*)
            printf '{"sha":"%s"}\n' "$GH_SHA"
            exit 0;;
    esac
    exit 22
fi
if [[ "$url" == https://api.github.com/repos/carlos-emr/drugref2026/* ]]; then
    [[ -n "${STUB_GH_DOWN:-}" ]] && exit 7
    case "$url" in
        */releases?*)
            case "${STUB_GH_DR_RELEASES:-full}" in
                none) echo '[]';;
                *)
                    printf '[{"tag_name":"v1.0.0rc2","prerelease":false,"draft":false,"published_at":"2026-03-21T22:27:21Z","assets":[{"name":"drugref2.war","browser_download_url":"https://github.com/carlos-emr/drugref2026/releases/download/v1.0.0rc2/drugref2.war","digest":"sha256:%s"}]}]\n' "$GH_DR_WAR_SHA";;
            esac
            exit 0;;
        */commits/*)
            printf '{"sha":"%s"}\n' "$GH_DR_SHA"
            exit 0;;
    esac
    exit 22
fi

case "$url" in
    *:8428/health*) [[ -n "${STUB_VM_DOWN:-}" ]] && exit 7; exit 0;;
    *:9428/health*) [[ -n "${STUB_VL_DOWN:-}" ]] && exit 7; exit 0;;
    */api/v1/query*)
        [[ -n "${STUB_VM_DOWN:-}" ]] && exit 7
        # Scalar responses: down-count queries read 0, everything else 1 —
        # enough for both the monitor (mysql_up, count(up == 0)) and check
        # (count(up), count(up{job=...} == 1), mysql_up).
        q=""
        prev=""
        for a in "$@"; do
            [[ "$prev" == "--data-urlencode" ]] && q="$a"
            prev="$a"
        done
        if [[ "$q" == *mysql_up* && -n "${STUB_MYSQL_DOWN:-}" ]]; then
            echo '{"status":"success","data":{"result":[{"value":[0,"0"]}]}}'
        elif [[ "$q" == *"== 0"* ]]; then
            echo '{"status":"success","data":{"result":[{"value":[0,"0"]}]}}'
        else
            echo '{"status":"success","data":{"result":[{"value":[0,"1"]}]}}'
        fi
        exit 0;;
    */select/logsql/query*)
        [[ -n "${STUB_VL_DOWN:-}" ]] && exit 7
        [[ -n "${STUB_LOGS_STALE:-}" ]] && exit 0   # /health OK, but no recent lines
        echo '{"_msg":"stub log line"}'
        exit 0;;
esac
# Front-door end-to-end probe (monitor + check): an argv https:// URL with the
# status-code write-out. Prints the stubbed code like curl -w %{http_code}.
if [[ "$url" == https://* && " $* " == *" %{http_code} "* ]]; then
    if [[ -n "${STUB_FRONT_DOOR:-}" ]]; then printf '%s' "$STUB_FRONT_DOOR"; exit 0; fi
    printf '000'; exit 7
fi
if [[ " $* " == *" -X POST "* && -n "${STUB_WEBHOOK_OK:-}" ]]; then exit 0; fi
exit 7
